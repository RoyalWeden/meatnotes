{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quartz-dev",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/usr/local/bin:$PATH && npx quartz build --serve"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "sync-app-ui",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH && node quartz/tools/sync-app/preview-server.mjs"],
      "port": 4321,
      "autoPort": true
    }
  ]
}
