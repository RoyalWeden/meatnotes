{
  "name": "quartz-sync-app",
  "version": "1.0.0",
  "description": "macOS menu bar app for managing Quartz sync",
  "author": "roywe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "plist": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.roywe.quartz-sync-app",
    "productName": "Quartz Sync",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dir", "arch": ["arm64"] }]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "node_modules/**/*"
    ]
  }
}
